---
import { ChevronLeft, ChevronRight, Flame } from 'lucide-react';
import { flavorItems, flavorShowcaseSection } from '../../content';
import Container from '../ui/Container.astro';
---

<section
  id="heat"
  aria-labelledby="flavor-showcase-title"
  class="relative overflow-hidden bg-coal-950 py-12 sm:py-14 lg:py-16 text-cream border-t border-white/5"
>
  {/* Ambient flame aura background */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 size-[650px] rounded-full bg-radial from-peri-red/10 via-ember/5 to-transparent blur-3xl"
  />

  <Container>
    {/* Section Header: Minimal, bold, tight vertical gap */}
    <div class="mb-7 sm:mb-9 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-peri-red mb-2">
        <Flame className="size-4 text-peri-red animate-pulse" aria-hidden="true" />
        <span>{flavorShowcaseSection.eyebrow}</span>
      </div>

      <h2
        id="flavor-showcase-title"
        class="font-display text-3xl uppercase tracking-tight text-cream sm:text-4xl lg:text-5xl"
      >
        {flavorShowcaseSection.title[0]}{' '}
        <span class="text-peri-red">{flavorShowcaseSection.title[1]}</span>
      </h2>
    </div>

    {/* ── Desktop Balanced 5-Column Grid ── */}
    <div
      role="list"
      aria-label="Nos sauces signatures"
      class="hidden lg:grid lg:grid-cols-5 lg:gap-4 xl:gap-5"
    >
      {flavorItems.map((flavor) => (
        <article
          role="listitem"
          class={`group relative flex h-[360px] xl:h-[380px] flex-col justify-between items-center text-center rounded-3xl p-5 xl:p-6 bg-gradient-to-b ${flavor.theme.bgGradient} border ${flavor.theme.borderColor} ${flavor.theme.borderHoverColor} ${flavor.theme.shadowClass} transition-all duration-300 hover:-translate-y-1.5 overflow-hidden`}
        >
          {/* Subtle Glossy Surface Sheen */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 h-44 rounded-t-3xl bg-gradient-to-b from-white/[0.14] via-white/[0.04] to-transparent"
          />

          {/* Ambient Glow behind illustration */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute top-10 left-1/2 -translate-x-1/2 size-48 rounded-full blur-2xl opacity-40 group-hover:opacity-65 transition-opacity duration-300"
            style={`background: radial-gradient(circle, ${flavor.theme.glowColor} 0%, transparent 70%);`}
          />

          {/* Priority 1: Large Food Illustration (55-60% of card) */}
          <div class="relative z-10 flex h-[210px] xl:h-[225px] w-full items-center justify-center pt-2">
            <img
              src={flavor.image}
              alt={flavor.imageAlt}
              width="240"
              height="240"
              loading="lazy"
              decoding="async"
              class="h-full w-auto max-w-[92%] object-contain drop-shadow-[0_12px_24px_rgba(0,0,0,0.5)] transition-transform duration-300 group-hover:scale-105"
            />
          </div>

          {/* Priority 2 & 3: Bold Flavor Name + Short Tagline */}
          <div class="relative z-10 w-full mt-auto pt-2 pb-1 text-center">
            <h3 class="font-display text-2xl xl:text-[1.75rem] uppercase tracking-tight text-white leading-tight font-black drop-shadow-sm">
              {flavor.name}
            </h3>
            <p
              class={`mt-1.5 text-xs xl:text-[13px] font-extrabold uppercase tracking-[0.14em] drop-shadow-sm ${flavor.theme.taglineColor}`}
            >
              {flavor.tagline}
            </p>
          </div>
        </article>
      ))}
    </div>

    {/* ── Mobile Horizontal Accessible Carousel ── */}
    <div class="lg:hidden relative">
      <div
        id="flavor-carousel-track"
        tabindex="0"
        role="region"
        aria-label="Carrousel des 5 saveurs signatures"
        class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-none px-4 sm:px-6 pb-3 pt-1 -mx-4 sm:-mx-6 outline-none focus-visible:ring-2 focus-visible:ring-peri-red"
      >
        {flavorItems.map((flavor, index) => (
          <article
            data-flavor-card
            data-card-index={index}
            class={`relative flex-none w-[265px] sm:w-[295px] h-[345px] sm:h-[365px] snap-center flex flex-col justify-between items-center text-center rounded-3xl p-5 bg-gradient-to-b ${flavor.theme.bgGradient} border ${flavor.theme.borderColor} shadow-lg overflow-hidden`}
          >
            {/* Glossy Surface Sheen */}
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-x-0 top-0 h-36 rounded-t-3xl bg-gradient-to-b from-white/[0.14] to-transparent"
            />

            {/* Ambient Glow */}
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-8 left-1/2 -translate-x-1/2 size-40 rounded-full blur-2xl opacity-40"
              style={`background: radial-gradient(circle, ${flavor.theme.glowColor} 0%, transparent 70%);`}
            />

            {/* Large Food Illustration */}
            <div class="relative z-10 flex h-[195px] sm:h-[210px] w-full items-center justify-center pt-2">
              <img
                src={flavor.image}
                alt={flavor.imageAlt}
                width="200"
                height="200"
                loading="lazy"
                decoding="async"
                class="h-full w-auto max-w-[90%] object-contain drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)]"
              />
            </div>

            {/* Bold Flavor Name & Short Tagline */}
            <div class="relative z-10 w-full mt-auto pt-2 pb-1 text-center">
              <h3 class="font-display text-xl sm:text-2xl uppercase tracking-tight text-white leading-tight font-black drop-shadow-sm">
                {flavor.name}
              </h3>
              <p
                class={`mt-1.5 text-xs font-extrabold uppercase tracking-[0.14em] drop-shadow-sm ${flavor.theme.taglineColor}`}
              >
                {flavor.tagline}
              </p>
            </div>
          </article>
        ))}
      </div>

      {/* Mobile Navigation Controls: Arrows & Indicators */}
      <div class="mt-4 flex items-center justify-between px-2">
        {/* Previous Button */}
        <button
          id="flavor-prev-btn"
          type="button"
          aria-label="Saveur précédente"
          class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-coal-900/90 text-cream transition-all duration-200 hover:border-peri-red hover:bg-peri-red/20 hover:text-white active:scale-95 focus-visible:ring-2 focus-visible:ring-peri-red"
        >
          <ChevronLeft className="size-5" aria-hidden="true" />
        </button>

        {/* Progress Dots Indicator */}
        <div
          role="tablist"
          aria-label="Indicateurs de saveurs"
          class="flex items-center gap-2"
        >
          {flavorItems.map((flavor, index) => (
            <button
              type="button"
              role="tab"
              data-dot-index={index}
              aria-label={`Aller à la saveur ${flavor.name}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              class={`flavor-carousel-dot h-2 rounded-full transition-all duration-300 ${
                index === 0 ? 'w-6 bg-peri-red' : 'w-2 bg-white/20 hover:bg-white/40'
              }`}
            />
          ))}
        </div>

        {/* Next Button */}
        <button
          id="flavor-next-btn"
          type="button"
          aria-label="Saveur suivante"
          class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-coal-900/90 text-cream transition-all duration-200 hover:border-peri-red hover:bg-peri-red/20 hover:text-white active:scale-95 focus-visible:ring-2 focus-visible:ring-peri-red"
        >
          <ChevronRight className="size-5" aria-hidden="true" />
        </button>
      </div>
    </div>
  </Container>
</section>

<script>
  function setupFlavorCarousel() {
    const track = document.getElementById('flavor-carousel-track');
    const prevBtn = document.getElementById('flavor-prev-btn');
    const nextBtn = document.getElementById('flavor-next-btn');
    const dots = document.querySelectorAll<HTMLButtonElement>('.flavor-carousel-dot');
    const cards = document.querySelectorAll<HTMLElement>('[data-flavor-card]');

    if (!track || cards.length === 0) return;

    let currentIndex = 0;

    function updateActiveDot(index: number) {
      currentIndex = Math.max(0, Math.min(index, cards.length - 1));
      dots.forEach((dot, idx) => {
        const isActive = idx === currentIndex;
        dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        if (isActive) {
          dot.classList.remove('w-2', 'bg-white/20');
          dot.classList.add('w-6', 'bg-peri-red');
        } else {
          dot.classList.remove('w-6', 'bg-peri-red');
          dot.classList.add('w-2', 'bg-white/20');
        }
      });
    }

    function scrollToIndex(index: number) {
      const targetCard = cards[index];
      if (targetCard && track) {
        const left = targetCard.offsetLeft - track.offsetLeft;
        track.scrollTo({ left, behavior: 'smooth' });
        updateActiveDot(index);
      }
    }

    prevBtn?.addEventListener('click', () => {
      scrollToIndex(currentIndex > 0 ? currentIndex - 1 : cards.length - 1);
    });

    nextBtn?.addEventListener('click', () => {
      scrollToIndex(currentIndex < cards.length - 1 ? currentIndex + 1 : 0);
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-dot-index'));
        if (!Number.isNaN(idx)) {
          scrollToIndex(idx);
        }
      });
    });

    track.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToIndex(Math.max(0, currentIndex - 1));
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToIndex(Math.min(cards.length - 1, currentIndex + 1));
      }
    });

    let scrollTimeout: ReturnType<typeof setTimeout>;
    track.addEventListener(
      'scroll',
      () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollLeft = track.scrollLeft;
          let closestIndex = 0;
          let minDistance = Number.POSITIVE_INFINITY;

          cards.forEach((card, idx) => {
            const cardLeft = card.offsetLeft - track.offsetLeft;
            const distance = Math.abs(cardLeft - scrollLeft);
            if (distance < minDistance) {
              minDistance = distance;
              closestIndex = idx;
            }
          });

          updateActiveDot(closestIndex);
        }, 60);
      },
      { passive: true },
    );
  }

  setupFlavorCarousel();
  document.addEventListener('astro:page-load', setupFlavorCarousel);
</script>
