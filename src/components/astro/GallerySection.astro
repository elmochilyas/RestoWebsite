---
import { ArrowLeft, ArrowRight, ArrowUpRight, Camera, Flame, MapPin, Play, Plus, X } from 'lucide-react';
import { SiInstagram } from 'react-icons/si';
import { galleryReels, galleryPhotos, gallerySection, restaurant } from '../../content';
import Container from '../ui/Container.astro';
import '../../styles/gallery.css';
---

<section id="gallery" class="gallery-section" aria-labelledby="gallery-title" data-gallery>
  <Container>
    <header class="gallery-heading">
      <div>
        <p class="gallery-eyebrow"><Flame className="size-4" aria-hidden="true" />{gallerySection.eyebrow}</p>
        <h2 id="gallery-title" class="gallery-title font-display">
          {gallerySection.titleLines.map((line) => <span class:list={['block', { 'gallery-title-accent': line.accent }]}>{line.text}</span>)}
        </h2>
      </div>
      <div class="gallery-heading-aside">
        <p>Un tour côté grill, une table entre amis, un peu d’Agadir Bay. Entrez dans l’ambiance.</p>
        <a class="gallery-instagram" href={restaurant.links.instagram} target="_blank" rel="noopener noreferrer" aria-label="Suivre @africanaperiperigrill sur Instagram (nouvel onglet)"><SiInstagram className="size-4" aria-hidden="true" /><span>@africanaperiperigrill</span><ArrowUpRight className="size-4" aria-hidden="true" /></a>
      </div>
    </header>

    <div class="gallery-reels">
      <div class="gallery-strip-heading"><h3 class="gallery-strip-label">Les instants péri-péri</h3><span class="gallery-strip-note">Un peu plus près du feu.</span></div>
      <div class="gallery-reel-track" role="region" aria-label="Les instants côté grill" tabindex="0" data-gallery-track style={`--gallery-reel-width: calc((100% - ${(galleryReels.length - 1) * 18}px) / ${galleryReels.length})`}>
        {galleryReels.map((reel, index) => (
          <a class="gallery-reel" href={reel.videoSrc ?? reel.poster} target="_blank" rel="noopener"
            data-gallery-item data-gallery-id={reel.id} data-title={reel.title} data-alt={reel.alt}
            data-image={reel.poster} data-video={reel.videoSrc} data-captions={reel.captions?.src}
            data-captions-lang={reel.captions?.language} data-captions-label={reel.captions?.label}
            aria-label={reel.videoSrc ? `Lire la vidéo : ${reel.title}` : `Agrandir la photo : ${reel.title}`}>
            <img src={reel.poster} alt={reel.alt} width="540" height="960" loading="lazy" decoding="async" style={`object-position: ${reel.objectPosition ?? 'center'}`} />
            <span class="gallery-reel-top"><span class="gallery-frame-number">INSTANT {String(index + 1).padStart(2, '0')}</span><span class="gallery-media-type">{reel.videoSrc ? <Play className="size-3" aria-hidden="true" /> : <Camera className="size-3" aria-hidden="true" />}{reel.videoSrc ? 'Film' : 'Photo'}</span></span>
            <span class="gallery-reel-caption"><span class="gallery-reel-open" aria-hidden="true">{reel.videoSrc ? <Play className="size-5 fill-current" /> : <ArrowUpRight className="size-5" />}</span><strong>{reel.title}</strong><span>{reel.subtitle}</span></span>
          </a>
        ))}
      </div>
      <div class="gallery-reel-controls" data-gallery-controls hidden>
        <span class="gallery-reel-progress" aria-hidden="true">{galleryReels.map((_, index) => <span class:list={{ 'is-current': index === 0 }} data-gallery-progress />)}</span>
        <div class="gallery-reel-navigation"><span class="gallery-reel-position" data-gallery-position aria-live="polite" aria-atomic="true">01 / {String(galleryReels.length).padStart(2, '0')}</span><button type="button" class="gallery-round-button" data-gallery-prev aria-label="Instant précédent" disabled><ArrowLeft className="size-[18px]" aria-hidden="true" /></button><button type="button" class="gallery-round-button" data-gallery-next aria-label="Instant suivant"><ArrowRight className="size-[18px]" aria-hidden="true" /></button></div>
      </div>
    </div>

    <div class="gallery-place">
      <div class="gallery-place-heading"><h3>Et si on se retrouvait ici ?</h3><span><MapPin className="size-3.5" aria-hidden="true" />Agadir Bay, côté partage.</span></div>
      <div class="gallery-place-grid">
        {galleryPhotos.map((photo) => (
          <a class="gallery-photo" href={photo.image} target="_blank" rel="noopener" data-gallery-item data-gallery-id={photo.id} data-title={photo.caption} data-image={photo.image} data-alt={photo.alt} aria-label={`Agrandir la photo : ${photo.caption}`}>
            <img src={photo.image} alt={photo.alt} width="800" height="800" loading="lazy" decoding="async" style={`object-position: ${photo.objectPosition}`} />
            <span class="gallery-photo-label">{photo.label}</span><span class="gallery-photo-caption"><strong>{photo.caption}</strong><span aria-hidden="true"><Plus className="size-4" /></span></span>
          </a>
        ))}
        <div class="gallery-invitation"><Flame className="size-7" aria-hidden="true" /><div><h4>ON GARDE<br />UNE PLACE<br />POUR VOUS.</h4><p>Du feu, du goût et de bons moments à partager.</p></div><a href={restaurant.links.maps} target="_blank" rel="noopener noreferrer" aria-label="Nous trouver sur Google Maps (nouvel onglet)">Nous trouver<ArrowUpRight className="size-4" aria-hidden="true" /></a></div>
      </div>
    </div>
  </Container>

  <dialog class="gallery-lightbox" aria-labelledby="gallery-viewer-title" data-gallery-dialog>
    <div class="gallery-viewer-top"><span>Les instants péri-péri</span><button type="button" class="gallery-round-button" data-gallery-close aria-label="Fermer la galerie" autofocus><X className="size-5" aria-hidden="true" /></button></div>
    <div class="gallery-viewer-media"><img data-gallery-full-image hidden alt="" /><video data-gallery-video controls playsinline preload="none" hidden aria-label="Vidéo de la galerie"></video><p class="gallery-viewer-error" data-gallery-error hidden>Ce média ne peut pas être chargé.<a data-gallery-original target="_blank" rel="noopener">Ouvrir le fichier original</a></p></div>
    <div class="gallery-viewer-bottom"><div><h3 class="gallery-viewer-title" id="gallery-viewer-title" data-gallery-viewer-title></h3><span class="gallery-viewer-count" data-gallery-viewer-count aria-live="polite" aria-atomic="true"></span></div><div class="gallery-viewer-nav"><button type="button" class="gallery-round-button" data-gallery-viewer-prev aria-label="Média précédent"><ArrowLeft className="size-[18px]" aria-hidden="true" /></button><button type="button" class="gallery-round-button" data-gallery-viewer-next aria-label="Média suivant"><ArrowRight className="size-[18px]" aria-hidden="true" /></button></div></div>
  </dialog>
</section>

<script>
  import { setupGallery } from '../../lib/gallery';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(setupGallery);
</script>
