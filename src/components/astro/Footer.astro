---
import { ArrowUp, ArrowUpRight, MapPin, Phone } from 'lucide-react';
import { SiInstagram, SiGlovo, SiGooglemaps, SiWhatsapp } from 'react-icons/si';
import { restaurant } from '../../content';
import { navLinks } from '../../content/navigation';
import Container from '../ui/Container.astro';
import PeriPeriLogo from '../ui/PeriPeriLogo.astro';

const year = new Date().getFullYear();
const contactActions = [
  { icon: SiInstagram, label: 'Instagram', action: 'Suivre le grill', href: restaurant.links.instagram },
  ...(restaurant.links.whatsapp ? [{ icon: SiWhatsapp, label: 'WhatsApp', action: 'Nous écrire', href: restaurant.links.whatsapp }] : []),
  { icon: SiGlovo, label: 'Glovo', action: 'Se faire livrer', href: restaurant.links.glovo },
  { icon: SiGooglemaps, label: 'Google Maps', action: 'Nous retrouver', href: restaurant.links.maps },
];
---

<footer id="site-footer" class="site-footer border-t border-line-dark bg-[#0d0907] text-cream">
  <Container>
    <div class="grid gap-9 py-10 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-9 sm:py-14 lg:grid-cols-[1.1fr_0.7fr_1.2fr] lg:gap-12 lg:py-16">
      <div class="min-w-0 sm:col-span-2 lg:col-span-1">
        <a href="/" aria-label="Peri Peri Grill — accueil" class="inline-flex rounded-sm">
          <PeriPeriLogo width={150} height={83} class="h-[83px] w-[150px]" />
        </a>
        <p class="mt-4 max-w-xs font-editorial text-2xl leading-snug text-cream">Du feu. Du goût. Du partage.</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-smoke">Votre poulet braisé à la flamme, au cœur d’Agadir Bay.</p>
        <div class="mt-5 flex flex-col items-start gap-1">
          <a href="/#visit" class="inline-flex min-h-11 items-center gap-2.5 text-sm text-smoke transition-colors hover:text-cream">
            <MapPin className="size-4 shrink-0 text-ember" aria-hidden="true" />
            {restaurant.address.split(',')[0]} · {restaurant.locationName}
          </a>
          <a href={restaurant.phoneHref} aria-label={`Appeler Peri Peri Grill au ${restaurant.phoneDisplay}`} class="inline-flex min-h-11 items-center gap-2.5 text-base font-bold transition-colors hover:text-ember">
            <Phone className="size-4 shrink-0 text-ember" aria-hidden="true" />
            {restaurant.phoneDisplay}
          </a>
        </div>
      </div>
      <nav aria-labelledby="footer-navigation-title" class="min-w-0 border-t border-line-dark pt-6 sm:border-t-0 sm:pt-0 lg:pt-2">
        <h2 id="footer-navigation-title" class="text-xs font-bold uppercase tracking-[0.16em] text-smoke">À découvrir</h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 sm:grid-cols-1">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center py-2 text-sm font-semibold transition-colors hover:text-ember">
                {link.label.charAt(0) + link.label.slice(1).toLocaleLowerCase('fr')}
              </a>
            </li>
          ))}
          <li>
            <a href="/#opening-hours" class="inline-flex min-h-11 items-center py-2 text-sm font-semibold transition-colors hover:text-ember">Nos horaires</a>
          </li>
        </ul>
      </nav>
      <div class="min-w-0 border-t border-line-dark pt-6 sm:border-t-0 sm:pt-0 lg:pt-2">
        <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-smoke">Gardons le contact</h2>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-1 xl:grid-cols-2">
          {contactActions.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.action} sur ${item.label} (nouvel onglet)`} class="footer-contact group flex min-h-[92px] min-w-0 items-start gap-3 rounded-xl border border-line-dark bg-cream/[0.025] p-3.5 transition-colors hover:border-cream/35 hover:bg-cream/[0.06]">
              <item.icon className="mt-0.5 size-[18px] shrink-0 text-cream" aria-hidden="true" />
              <span class="min-w-0 flex-1">
                <span class="flex items-center justify-between gap-1 text-sm font-bold">
                  {item.label}
                  <ArrowUpRight className="size-3.5 shrink-0 text-smoke transition-colors group-hover:text-ember" aria-hidden="true" />
                </span>
                <span class="mt-1 block text-xs leading-relaxed text-smoke">{item.action}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="flex flex-col gap-3 border-t border-line-dark py-5 text-xs text-smoke sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <p class="leading-relaxed">© {year} {restaurant.name}<span class="mx-2 text-cream/30" aria-hidden="true">/</span>{restaurant.locationName}</p>
      <a href="#main-content" class="inline-flex min-h-11 items-center gap-2 self-start rounded-sm font-semibold transition-colors hover:text-cream sm:self-auto">
        Retour en haut
        <ArrowUp className="size-4" aria-hidden="true" />
      </a>
    </div>
  </Container>
</footer>

<style>
  .site-footer { padding-bottom: env(safe-area-inset-bottom, 0px); }
  @media (max-width: 359px) {
    .footer-contact { flex-direction: column; gap: 0.625rem; }
    .footer-contact > span { width: 100%; }
  }
</style>
