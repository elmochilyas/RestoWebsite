---
import { ArrowUpRight, Clock3, Flame, MapPin, Moon, Navigation, Phone } from 'lucide-react';
import { SiWhatsapp } from 'react-icons/si';
import { restaurant } from '../../content';
import type { DayName } from '../../types/content';
import Container from '../ui/Container.astro';
import '../../styles/visit.css';

const dayLabels: Record<DayName, string> = {
  monday: 'Lundi', tuesday: 'Mardi', wednesday: 'Mercredi', thursday: 'Jeudi',
  friday: 'Vendredi', saturday: 'Samedi', sunday: 'Dimanche',
};
const hours = restaurant.publicInfo.hours;
const anyClosesNextDay = hours.some((day) => day.closesNextDay);
const commonLateClose = hours.length > 0 && hours.every(
  (day) => day.closesNextDay && day.close === hours[0].close,
) ? hours[0].close : null;
const earliestOpen = [...hours].map((day) => day.open).sort()[0];
const laterDays = hours.filter((day) => day.open > earliestOpen);
const mapQuery = `${restaurant.name} - ${restaurant.locationName}, ${restaurant.address}`;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`;
const [addressLine, ...addressRest] = restaurant.address.split(',').map((line) => line.trim());
---

<section id="visit" aria-labelledby="visit-title" class="visit-section">
  <Container>
    <header class="visit-heading">
      <div><p class="visit-eyebrow"><MapPin className="size-4" aria-hidden="true" />On se retrouve ici</p><h2 id="visit-title" class="visit-title font-display">LE GOÛT A<span>SON ADRESSE.</span></h2></div>
      <p class="visit-intro">Une pause déjeuner, une grande tablée ou une envie de grillades après le coucher du soleil. Rendez-vous à {restaurant.locationName}.</p>
    </header>

    <div class="visit-layout">
      <div class="visit-map-card">
        <div class="visit-map-heading"><div><p class="visit-map-kicker"><MapPin className="size-3" aria-hidden="true" />{restaurant.locationName} · {restaurant.city}</p><h3>{restaurant.name}</h3></div><a class="visit-map-icon" href={restaurant.links.maps} target="_blank" rel="noopener noreferrer" aria-label="Agrandir la carte dans Google Maps (nouvel onglet)"><ArrowUpRight className="size-5" aria-hidden="true" /></a></div>
        <div class="visit-map-frame"><iframe src={mapEmbedUrl} title={`Localisation de ${restaurant.name} à ${restaurant.locationName}, ${restaurant.city}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
        <div class="visit-map-footer">
          <address class="visit-address"><MapPin className="size-4" aria-hidden="true" /><span><strong>{addressLine}</strong>{addressRest.join(', ')}</span></address>
          <a class="visit-directions" href={restaurant.links.maps} target="_blank" rel="noopener noreferrer" aria-label="Obtenir l’itinéraire vers Peri Peri Grill sur Google Maps (nouvel onglet)"><Navigation aria-hidden="true" /><span>Obtenir l’itinéraire</span><ArrowUpRight className="size-4" aria-hidden="true" /></a>
        </div>
      </div>

      <nav class="visit-contacts" aria-label="Contacter le restaurant">
        <a class="visit-contact" href={restaurant.phoneHref} aria-label={`Appeler Peri Peri Grill au ${restaurant.phoneDisplay}`}><span class="visit-contact-icon"><Phone className="size-[18px]" aria-hidden="true" /></span><span class="visit-contact-copy"><strong>Appeler</strong><span>{restaurant.phoneDisplay}</span></span><ArrowUpRight className="visit-contact-arrow size-4" aria-hidden="true" /></a>
        <a class="visit-contact visit-contact-whatsapp" href={restaurant.links.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Écrire à Peri Peri Grill sur WhatsApp (nouvel onglet)"><span class="visit-contact-icon"><SiWhatsapp className="size-[18px]" aria-hidden="true" /></span><span class="visit-contact-copy"><strong>WhatsApp</strong><span>Une question ? Écrivez-nous.</span></span><ArrowUpRight className="visit-contact-arrow size-4" aria-hidden="true" /></a>
      </nav>

      <section id="opening-hours" class="visit-hours-card" aria-labelledby="hours-title">
        <header class="visit-hours-heading"><div><p class="visit-hours-kicker"><Clock3 className="size-3.5" aria-hidden="true" />Horaires d’ouverture</p><h3 id="hours-title">{hours.length === 7 ? <>Le grill,<br /><span class="visit-hours-days">7 jours / 7.</span></> : 'À chacun son moment.'}</h3></div>{commonLateClose && <div class="visit-night-seal" aria-label={`Jusqu’à ${commonLateClose} du matin`}><Moon className="size-4" aria-hidden="true" /><span>Jusqu’à</span><strong>{commonLateClose}</strong></div>}</header>
        <table class="visit-hours-table" aria-describedby="hours-note">
          <caption class="sr-only">Horaires hebdomadaires de Peri Peri Grill à Agadir</caption>
          <thead><tr><th scope="col">Jour</th><th scope="col">Ouverture</th><th scope="col">Fermeture</th></tr></thead>
          <tbody>{hours.map((day) => (
            <tr data-opening-day={day.day} class:list={['visit-hours-row', { 'visit-hours-row-later': day.open > earliestOpen }]}>
              <th scope="row"><span>{dayLabels[day.day]}<span class="visit-today-label" data-today-label hidden>Aujourd’hui</span></span></th>
              <td><time>{day.open}</time></td><td><time>{day.close}</time>{day.closesNextDay && <span class="visit-next-day" aria-label="le lendemain">*</span>}</td>
            </tr>
          ))}</tbody>
        </table>
        <div class="visit-hours-notes">
          {laterDays.map((day) => <p class="visit-friday-note"><Flame className="size-3.5" aria-hidden="true" /><span>Le {dayLabels[day.day].toLowerCase()}, le grill s’allume à <strong>{day.open}</strong>.</span></p>)}
          <p id="hours-note" class="visit-hours-note">Heure locale d’Agadir.{anyClosesNextDay && ' * Fermeture le lendemain matin.'}</p>
        </div>
      </section>
    </div>
  </Container>
</section>

<script>
  // Highlight the restaurant's local day without claiming live opening status.
  function highlightVisitDay() {
    const today = new Intl.DateTimeFormat('en-US', {
      weekday: 'long', timeZone: 'Africa/Casablanca',
    }).format(new Date()).toLowerCase();
    document.querySelectorAll<HTMLElement>('#visit [data-opening-day]').forEach((row) => {
      const isToday = row.dataset.openingDay === today;
      row.toggleAttribute('data-today', isToday);
      const label = row.querySelector<HTMLElement>('[data-today-label]');
      if (label) label.hidden = !isToday;
    });
  }
  highlightVisitDay();
  window.setInterval(highlightVisitDay, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) highlightVisitDay();
  });
</script>
