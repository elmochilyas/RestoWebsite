---
import { ArrowLeft, ArrowRight, ArrowUpRight, Flame, Quote, Star } from 'lucide-react';
import { SiGoogle } from 'react-icons/si';
import { restaurant, reviews, reviewsSection } from '../../content';
import Container from '../ui/Container.astro';
import '../../styles/reviews.css';

const { rating, reviewCount, lastChecked } = restaurant.publicInfo;
const ratingLabel = rating.toLocaleString('fr-FR');
const checkedLabel = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${lastChecked}T12:00:00Z`));
const googleReviews = reviews.filter((review) => review.source === 'Google');
const reviewsUrl = restaurant.links.googleReviews;
---

<section id="reviews" class="reviews-section" aria-labelledby="reviews-title">
  <Container>
    <header class="reviews-heading">
      <div class="reviews-heading-copy">
        <p class="reviews-eyebrow"><Flame className="size-4" aria-hidden="true" />{reviewsSection.eyebrow}</p>
        <h2 id="reviews-title" class="reviews-title font-display">
          {reviewsSection.titleLines.map((line) => (
            <span class:list={['block', { 'reviews-title-accent': line.accent }]}>{line.text}</span>
          ))}
        </h2>
        <p class="reviews-intro">On allume le grill. Vous écrivez la suite.</p>
      </div>

      <a class="reviews-score" href={reviewsUrl} target="_blank" rel="noopener noreferrer"
        aria-label={`${ratingLabel} sur 5, sur ${reviewCount} avis. Lire les avis sur Google (nouvel onglet)`}>
        <div class="reviews-score-top"><span class="reviews-google-mark"><SiGoogle className="size-4" aria-hidden="true" /></span><span>Avis Google</span><ArrowUpRight className="size-4" aria-hidden="true" /></div>
        <div class="reviews-score-main"><strong class="font-display">{ratingLabel}</strong><span>/ 5</span><div class="reviews-score-stars"><span class="reviews-rating-stars" aria-hidden="true"><span>★★★★★</span><span class="reviews-rating-stars-fill" style={`width: ${rating / 5 * 100}%`}>★★★★★</span></span><span>{reviewCount} avis</span></div></div>
        <span class="reviews-score-caption">De belles tablées. De vrais retours.</span>
      </a>
    </header>

    <div class="reviews-collection" data-reviews-collection>
      <div class="reviews-track" id="reviews-track" role="region" aria-label="Sélection de trois avis clients Google" tabindex="0">
        {googleReviews.map((review, index) => (
          <article class:list={['review-ticket', { 'review-ticket-featured': index === 0 }]} aria-labelledby={`review-author-${review.id}`}>
            <div class="review-ticket-body">
              <div class="review-ticket-top"><span class="review-topic">{review.topic}</span><SiGoogle className="review-google-icon size-4" aria-label="Google" /></div>
              <div class="review-stars" role="img" aria-label={`${review.rating} étoiles sur 5`}>
                {Array.from({ length: 5 }, (_, star) => <Star className={`size-4 ${star < review.rating ? 'fill-current' : ''}`} aria-hidden="true" />)}
              </div>
              <Quote className="review-quote-mark" aria-hidden="true" />
              <blockquote><p lang="fr">« {review.quote} »</p></blockquote>
              <span class="review-excerpt">Extrait{review.translated ? ' · Traduction Google' : ''}</span>
            </div>
            <footer class="review-ticket-footer">
              <div class="review-author">
                <span class="review-avatar" aria-hidden="true">{review.reviewer.split(' ').map((name) => name[0]).slice(0, 2).join('')}</span>
                <div><p id={`review-author-${review.id}`} class="review-author-name">{review.reviewer}</p><span class="review-author-detail">{review.authorLabel ?? 'Avis sur Google'}</span></div>
              </div>
              <a class="review-source" href={review.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`Lire l’avis de ${review.reviewer} sur Google (nouvel onglet)`}><ArrowUpRight className="size-[18px]" aria-hidden="true" /></a>
            </footer>
          </article>
        ))}
      </div>
      <div class="reviews-mobile-controls" data-review-controls hidden>
        <span class="reviews-mobile-hint">À vous de faire défiler</span>
        <div class="reviews-pagination"><span data-review-position aria-live="polite" aria-atomic="true">1 / {googleReviews.length}</span><button type="button" data-review-prev aria-label="Avis précédent" disabled><ArrowLeft className="size-[18px]" aria-hidden="true" /></button><button type="button" data-review-next aria-label="Avis suivant"><ArrowRight className="size-[18px]" aria-hidden="true" /></button></div>
      </div>
    </div>

    <div class="reviews-bottom">
      <div><p class="reviews-invitation">Le prochain avis ? Peut-être le vôtre.</p><p class="reviews-disclosure">Sélection de {googleReviews.length} avis 5 étoiles. Note et avis relevés le {checkedLabel}.</p></div>
      <a class="reviews-all-link" href={reviewsUrl} target="_blank" rel="noopener noreferrer" aria-label={`Lire les ${reviewCount} avis sur Google (nouvel onglet)`}><span>Lire les {reviewCount} avis sur Google</span><span class="reviews-all-link-arrow"><ArrowUpRight className="size-5" aria-hidden="true" /></span></a>
    </div>
  </Container>
</section>

<script>
  const collection = document.querySelector<HTMLElement>('[data-reviews-collection]');
  if (collection) {
    const track = collection.querySelector<HTMLElement>('.reviews-track')!;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.review-ticket'));
    const controls = collection.querySelector<HTMLElement>('[data-review-controls]')!;
    const previous = collection.querySelector<HTMLButtonElement>('[data-review-prev]')!;
    const next = collection.querySelector<HTMLButtonElement>('[data-review-next]')!;
    const position = collection.querySelector<HTMLElement>('[data-review-position]')!;
    let active = 0;
    const sync = () => {
      const trackLeft = track.getBoundingClientRect().left;
      active = cards.reduce((nearest, card, index) =>
        Math.abs(card.getBoundingClientRect().left - trackLeft) < Math.abs(cards[nearest].getBoundingClientRect().left - trackLeft) ? index : nearest, 0);
      position.textContent = `${active + 1} / ${cards.length}`;
      previous.disabled = active === 0;
      next.disabled = active === cards.length - 1;
    };
    const go = (direction: number) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, active + direction))];
      track.scrollTo({ left: track.scrollLeft + card.getBoundingClientRect().left - track.getBoundingClientRect().left,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    controls.hidden = false;
    previous.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', sync, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (event.target !== track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      go(event.key === 'ArrowRight' ? 1 : -1);
    });
    new ResizeObserver(sync).observe(track);
    sync();
  }
</script>
