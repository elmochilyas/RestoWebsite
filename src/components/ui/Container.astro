---
interface Props {
  class?: string;
  className?: string;
  [key: string]: any;
}

const { class: classNameProp, className, ...rest } = Astro.props;
const classes = classNameProp || className || '';
---

<div class={`mx-auto w-full max-w-content px-5 sm:px-8 lg:px-12 ${classes}`} {...rest}>
  <slot />
</div>
