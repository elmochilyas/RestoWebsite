---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/layout/Header';
import { Hero } from '../components/sections/Hero';
import SignatureDishes from '../components/astro/SignatureDishes.astro';
import { HeatSelector } from '../components/sections/HeatSelector';
import StorySection from '../components/astro/StorySection.astro';
import GallerySection from '../components/astro/GallerySection.astro';
import ReviewsSection from '../components/astro/ReviewsSection.astro';
import VisitSection from '../components/astro/VisitSection.astro';
import Footer from '../components/astro/Footer.astro';
---

<Layout>
  <Header client:load />
  <main id="main-content">
    <Hero client:load />
    <SignatureDishes />
    <HeatSelector client:visible />
    <StorySection />
    <GallerySection />
    <ReviewsSection />
    <VisitSection />
  </main>
  <Footer />
</Layout>
